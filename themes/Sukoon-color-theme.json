    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#637777",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#D6DEEA"
            }
        },
        {
            "name": "Function Parameters",
            "scope": [
                "variable.parameter",
                "variable.parameter.function"
            ],
            "settings": {
                "foreground": "#F07178"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.other",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#C792EA"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.logical",
                "keyword.operator.bitwise",
                "keyword.operator.ternary",
                "keyword.operator.new"
            ],
            "settings": {
                "foreground": "#89DDFF"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "entity.name.function.js",
                "entity.name.function.ts",
                "meta.function-call",
                "variable.function",
                "support.function",
                "entity.name.method",
                "entity.name.method.js",
                "entity.name.method.ts"
            ],
            "settings": {
                "foreground": "#4F8CFF"
            }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.class",
                "entity.name.type.class",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#FFCB8B"
            }
        },
        {
            "name": "Types",
            "scope": [
                "support.type",
                "support.class",
                "support.type.primitive",
                "entity.name.type.interface",
                "entity.name.type.enum"
            ],
            "settings": {
                "foreground": "#82AAFF"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.single",
                "string.quoted.double",
                "string.template",
                "string.unquoted"
            ],
            "settings": {
                "foreground": "#C3E88D"
            }
        },
        {
            "name": "String Interpolation",
            "scope": [
                "meta.template.expression",
                "punctuation.definition.template-expression"
            ],
            "settings": {
                "foreground": "#89DDFF"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.binary"
            ],
            "settings": {
                "foreground": "#F78C6C"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "constant.language",
                "constant.character",
                "constant.other",
                "support.constant"
            ],
            "settings": {
                "foreground": "#FFCB6B"
            }
        },
        {
            "name": "Booleans",
            "scope": [
                "constant.language.boolean",
                "constant.language.true",
                "constant.language.false"
            ],
            "settings": {
                "foreground": "#C3E88D"
            }
        },
        {
            "name": "Null",
            "scope": [
                "constant.language.null"
            ],
            "settings": {
                "foreground": "#FF5370"
            }
        },
        {
            "name": "Object Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "meta.object-literal.key",
                "support.type.property-name",
                "entity.name.property"
            ],
            "settings": {
                "foreground": "#80CBC4"
            }
        },
        {
            "name": "Decorators",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#C792EA"
            }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#89DDFF"
            }
        },
        {
            "name": "Escape Characters",
            "scope": [
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#FFCB6B"
            }
        },
        {
            "name": "HTML Tags",
            "scope": [
                "entity.name.tag",
                "entity.name.tag.html",
                "entity.name.tag.tsx",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#F07178"
            }
        },
        {
            "name": "HTML Attributes",
            "scope": [
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#C792EA"
            }
        },
        {
            "name": "CSS Selectors",
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name.id",
                "entity.name.tag.css"
            ],
            "settings": {
                "foreground": "#F07178"
            }
        },
        {
            "name": "CSS Properties",
            "scope": [
                "support.type.property-name.css"
            ],
            "settings": {
                "foreground": "#80CBC4"
            }
        },
        {
            "name": "Markup Headings",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#FFCB8B"
            }
        },
        {
            "name": "Markup Bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#D6DEEA",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#B8C7D9",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Links",
            "scope": [
                "*url*",
                "*link*",
                "*uri*",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#4F8CFF",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Git Added",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#C3E88D"
            }
        },
        {
            "name": "Git Deleted",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#FF5370"
            }
        },
        {
            "name": "Git Changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#F78C6C"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FF5370"
            }
        }
    ],
    "semanticTokenColors": {
        "variable": "#D6DEEA",
        "variable.readonly": "#E0E6EE",
        "parameter": "#F07178",
        "parameter.readonly": "#E89A9F",
        "property": "#80CBC4",
        "property.readonly": "#8ED8D0",
        "function": "#4F8CFF",
        "function.declaration": "#4F8CFF",
        "method": "#4F8CFF",
        "method.declaration": "#4F8CFF",
        "class": "#FFCB8B",
        "class.declaration": "#FFCB8B",
        "interface": "#82AAFF",
        "type": "#82AAFF",
        "typeParameter": "#89DDFF",
        "enum": "#FFCB8B",
        "enumMember": "#F78C6C",
        "namespace": "#80CBC4",
        "module": "#80CBC4",
        "keyword": "#C792EA",
        "modifier": "#A8B4C5",
        "modifier.declaration": "#A8B4C5",
        "modifier.readonly": "#A8B4C5",
        "modifier.private": "#7F8C9D",
        "modifier.public": "#A8B4C5",
        "modifier.protected": "#8FA5BC",
        "modifier.static": "#B39DDB",
        "modifier.abstract": "#B39DDB",
        "string": "#C3E88D",
        "number": "#F78C6C",
        "boolean": "#C3E88D",
        "comment": "#637777",
        "regexp": "#89DDFF",
        "decorator": "#C792EA"
    }
}
